    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:passport-stack": "tsx scripts/dev-passport-stack.ts",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "smoke:github": "tsx scripts/smoke-passport-github.ts",
    "smoke:angelcoin": "tsx scripts/smoke-passport-angelcoin.ts",
    "smoke:agent-enrollment": "tsx scripts/smoke-passport-enrollment.ts",
    "smoke:presentation": "tsx scripts/smoke-presentation.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:contract": "tsx scripts/check-passport-contract.ts",
    "load:baseline": "tsx scripts/load-baseline.ts",
    "backup:db": "tsx scripts/backup-db.ts",
    "restore:verify": "tsx scripts/restore-verify.ts",
    "verify:receipt": "tsx scripts/verify-receipt.ts",
    "doctor:passport": "tsx scripts/doctor-passport.ts",
