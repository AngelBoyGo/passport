{
  "name": "passport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:passport-stack": "tsx scripts/dev-passport-stack.ts",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "smoke:github": "tsx scripts/smoke-passport-github.ts",
    "smoke:angelcoin": "tsx scripts/smoke-passport-angelcoin.ts",
    "smoke:agent-enrollment": "tsx scripts/smoke-passport-enrollment.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:contract": "tsx scripts/check-passport-contract.ts",
    "verify:receipt": "tsx scripts/verify-receipt.ts",
    "doctor:passport": "tsx scripts/doctor-passport.ts",
    "prestart": "tsx scripts/check-env.ts --prestart-only",
    "verify:container": "node scripts/run-verify-container.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:preflight": "prisma migrate status && prisma generate",
    "seed:evidence-minter": "tsx scripts/seed-evidence-minter.ts",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@prisma/client": "^6.19.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
