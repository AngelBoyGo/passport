    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "next": "16.3.1",
    "playwright": "^1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
