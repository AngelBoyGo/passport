generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ErrorTranche {
  DATA_LEAKAGE
  COMPUTE_TIMEOUT
  LOGIC_DETECTION
  SLA_BREACH
  NONE
}

enum OperationalDomain {
  FINANCIAL_CLEARING
  CUSTOMER_SUPPORT
  CODE_GENERATION
  SYSTEM_INTEGRATION
}

enum OperatorAccountStatus {
  ACTIVE
  ESCROW_INSOLVENT_BLOCKED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum EvidenceLinkageType {
  OBSERVATION
  CORRECTION
  FAILURE
  VALIDATION
}

enum EvidenceEnforcementState {
  OBSERVATIONAL_ONLY
  AUDIT_RELEVANT
  ENFORCEMENT_ELIGIBLE
}

enum AngelCoinCreditState {
  ACTIVE
  TRANSITION
  INACTIVE
}

enum AngelCoinEntryType {
  OPERATOR_GRANT
  PEER_GIFT
  TASK_PAYMENT
  SAFETY_NET_TOPUP
  RECOVERY_AWARD
  SPEND
  LOCK
  UNLOCK
  ADJUSTMENT
}

enum AccessTier {
  FULL
  LIMITED
  SANDBOXED
  SHELTERED
  SUSPENDED
}

enum EnrollmentStatus {
  PENDING
  ISSUED
  REVOKED
}

enum EngagementStatus {
  HELD
  DELIVERED
  PAID
  CANCELLED
}

model Operator {
  id                  String                @id @default(cuid())
  stripeCustomerId    String                @unique
  email               String?
  passwordHash        String?
  credits             Int                   @default(100)
  tier                String                @default("free")
  stakeBalanceCents   Int                   @default(0)
  accountStatus       OperatorAccountStatus @default(ACTIVE)
  kycStatus           KycStatus             @default(PENDING)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  agents             Agent[]
  apiKeys            ApiKey[]
  receipts           Receipt[]
  matchLedger        MatchLedgerEntry[]
  capabilityLedger   CapabilityLedgerEntry[]
  slashingLedger     SlashingLedger[]
  sessions           Session[]
  webhookSubscriptions WebhookSubscription[]
}

model Agent {
  id         String   @id @default(cuid())
  operatorId String
  agentId    String
  domain     String?
  createdAt  DateTime @default(now())

  operator Operator  @relation(fields: [operatorId], references: [id])
  receipts Receipt[]

  @@unique([operatorId, agentId])
}

/**
 * Fleet control plane — persisted instance lifecycle for fleet agents.
 * One instance per Passport: `commitment` (= Agent.agentId / AgentEnrollment.
 * subjectCommitment) is unique, and stopping an instance NEVER deletes the
 * Passport, enrollment, wallet, or evidence — it only releases the runtime
 * (status -> stopped) so a later spin-up rehydrates the same identity.
 *
 * llmTier values are restricted to src/lib/llm/tiers.ts LLM_TIERS
 * ("neuron" | "money"); the string column is intentional — it is exposed to
 * raw SQL surfaces and must not depend on an app-only enum.
 */
model AgentInstance {
  id               String    @id @default(cuid())
  commitment       String    @unique
  operatorId       String
  agentRecordId    String
  capability       String
  llmTier          String
  displayName      String?
  status           String    @default("provisioning") // provisioning|active|idle|stopped|failed
  reputationTier   String?
  lastSweepAt      DateTime?
  desiredCostCents Int       @default(0)
  totalEarnedCents Int       @default(0)
  totalSpentCents  Int       @default(0)
  capsuleDigest    String?
  rehydratedAt     DateTime?
  stoppedAt        DateTime?
  stopReason       String?
  lastHeartbeatAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([operatorId, status])
  @@index([capability, status])
}

/**
 * Money movement intents (the money-execution trigger, Phase 3).
 *
 * The brain can ONLY create a PENDING intent row — it never moves balances.
 * Execution requires, in code order, ALL THREE conditions verified at
 * authorizeMoneyMovement():
 *   1. the fleet execution switch is armed (FLEET_MONEY_MOVEMENT_ENABLED),
 *   2. the acting agent's PROVISIONED tier (AgentInstance.llmTier) is 'money'
 *      — never the model that happened to answer a prompt,
 *   3. the agent's own Ed25519 signature over the canonical intent matches the
 *      enrollment-pinned key (a forged or stolen prompt cannot move ANGEL).
 * intentDigest @unique makes each signed intent single-use and replay-safe.
 */
model MoneyIntent {
  id                  String            @id @default(cuid())
  intentKind          String
  requesterCommitment String?
  workerCommitment    String?
  amountAngels        Float
  intentDigest        String            @unique
  signature           String?
  status              String            @default("PENDING") // PENDING|AUTHORIZED|REJECTED|EXECUTED
  rejectionReason     String?
  attemptCount        Int               @default(0)
  lastAttemptAt       DateTime?
  cycleRef            String?
  reason              String?
  executedAt          DateTime?
  createdAt           DateTime          @default(now())

  @@index([status])
  @@index([status, lastAttemptAt])
  @@index([workerCommitment, status])
}

model Receipt {
  id               String    @id @default(cuid())
  receiptId        String    @unique @default(cuid())
  issuedAt         DateTime  @default(now())
  operatorId       String
  agentId          String
  agentRecordId    String
  receiptType      String
  status           String    @default("pending")
  inputDigest      String
  authorityScope   String
  expiry           DateTime
  revocationStatus String    @default("active")
  outputHash       String?
  refusalReason    String?
  terminalReason   String?
  prevReceiptHash  String?
  contentHash      String
  signature        String?
  finalizedAt      DateTime?
  domain           OperationalDomain?
  domainCommitment String?
  blindSalt        String?
  errorTranche     ErrorTranche?      @default(NONE)

  operator Operator @relation(fields: [operatorId], references: [id])
  agent    Agent    @relation(fields: [agentRecordId], references: [id])

  @@index([operatorId, domain])
  @@index([operatorId, domainCommitment])
  @@index([operatorId, issuedAt])
}

enum ApiKeyRole {
  ISSUER
  HOLDER
}

model ApiKey {
  id         String      @id @default(cuid())
  operatorId String
  keyHash    String      @unique
  name       String?
  role       ApiKeyRole  @default(ISSUER)
  createdAt  DateTime    @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])
}

/// Stripe webhook idempotency — one row per processed event id.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Match/settlement ledger — payout-critical events (separate from capability).
model MatchLedgerEntry {
  id         String   @id @default(cuid())
  operatorId String
  receiptId  String?
  eventType  String
  amount     Int?
  metadata   String?
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])
}

/// Economic staking slashing audit trail.
model SlashingLedger {
  id           String       @id @default(cuid())
  operatorId   String
  receiptId    String
  penaltyCents Int
  tranche      ErrorTranche
  timestamp    DateTime     @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
}

/// Capability ledger — reputation aggregation events (separate from match).
model CapabilityLedgerEntry {
  id         String   @id @default(cuid())
  operatorId String
  agentId    String?
  receiptId  String?
  eventType  String
  metadata   String?
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])
}

/// Privacy-safe agent evidence ingested from public GitHub / OTel sources.
model AgentEvidence {
  id                      String    @id @default(cuid())
  sourceType              String
  artifactType            String
  normalizedEventType     String
  rawErrorClassification  String?
  observedAt              DateTime
  agentIdentityCommitment String
  repositoryCommitment    String?
  branchCommitment        String?
  commitSha               String?
  sessionLogUrlCommitment String?
  sourceUrl               String?
  executionStartedAt      DateTime?
  executionFinishedAt     DateTime?
  tokenUsageInput         Int?
  tokenUsageOutput        Int?
  toolCallCount           Int?
  validationSignalPresent Boolean   @default(false)
  eventCommitmentHash     String    @unique
  sourceDigest            String?
  externalTaskId          String?
  createdAt               DateTime  @default(now())

  @@index([agentIdentityCommitment])
  @@index([normalizedEventType])
  @@index([commitSha])
  evidenceReceiptLinks EvidenceReceiptLink[]

  @@index([agentIdentityCommitment, observedAt])
  @@index([agentIdentityCommitment, observedAt, normalizedEventType])
  @@index([observedAt, normalizedEventType])
  @@index([externalTaskId])
  @@index([agentIdentityCommitment, externalTaskId])
}

/// Bridge joining immutable AgentEvidence to signed Receipt ledger rows.
model EvidenceReceiptLink {
  id                    String                   @id @default(cuid())
  agentEvidenceId       String
  eventCommitmentHash   String                   @unique
  receiptId             String
  receiptCommitmentHash String
  linkageType           EvidenceLinkageType
  enforcementState      EvidenceEnforcementState
  attributionMode       String                   @default("SYSTEM_ATTESTED_PUBLIC_EVIDENCE")
  liabilityEventId      String?
  predicateVersion      String
  linkedAt              DateTime                 @default(now())

  agentEvidence AgentEvidence @relation(fields: [agentEvidenceId], references: [id])

  @@index([receiptId])
}

/// AngelCoin internal transferable credit ledger keyed by agent identity commitment.
model AngelCoinAccount {
  id                String               @id @default(cuid())
  subjectCommitment String               @unique
  creditState       AngelCoinCreditState @default(ACTIVE)
  accessTier        AccessTier           @default(FULL)
  adminOverrideTier AccessTier?
  backingMetadata   String?
  /// H5: the operator that first created/claimed this account. Transfers FROM
  /// this account require ownership by the authenticated operator.
  ownerOperatorId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  journal AngelCoinJournalEntry[]

  @@index([subjectCommitment])
  @@index([ownerOperatorId])
}

/// Append-only AngelCoin journal entries for a subject account.
model AngelCoinJournalEntry {
  id                     String             @id @default(cuid())
  accountId              String
  entryType              AngelCoinEntryType
  amount                 Int
  counterpartyCommitment String?
  metadata               String?
  createdAt              DateTime           @default(now())

  account AngelCoinAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

/// Proof-based agent passport enrollment keyed by key-derived subject commitment.
model AgentEnrollment {
  id                 String           @id @default(cuid())
  subjectCommitment  String           @unique
  publicKey          String
  context            String
  status             EnrollmentStatus @default(PENDING)
  challengeNonce     String?
  challengeExpiresAt DateTime?
  issuedAt           DateTime?
  photoUrl           String?
  photoContentSha256 String?
  photoMimeType      String?
  photoUpdatedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
}

/// Signed agent intent nonce (Phase 31): a DB-unique replay guard for agent-signed value
/// operations (AMM swap/fractionalize, escrow release). A nonce may be consumed at most once.
model AgentIntentNonce {
  id              String   @id @default(cuid())
  nonce           String   @unique
  agentCommitment String
  action          String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([agentCommitment])
  @@index([expiresAt])
}

/// Autonomous spend policy (Phase 32): hard caps that let an AI agent transact without a human
/// approving every payment, while remaining undrainable. `0` means "no cap" for that dimension.
model AgentSpendPolicy {
  id                    String   @id @default(cuid())
  agentCommitment       String   @unique
  enabled               Boolean  @default(true)
  perTxMaxAngel         Int      @default(0)
  dailyMaxAngel         Int      @default(0)
  weeklyMaxAngel        Int      @default(0)
  counterpartyAllowlist Json? // array of 64-hex commitments; null/empty = any
  domainAllowlist       Json? // array of domain strings; null/empty = any
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabled])
}

/// Agent capability registry (Phase 32): what an agent can do, and at what price — so other
/// agents can discover and hire it. `(agentCommitment, capability)` is unique.
model AgentCapability {
  id              String   @id @default(cuid())
  agentCommitment String
  capability      String
  description     String?
  version         String?
  endpointUrl     String?
  priceAngel      Int      @default(0)
  unit            String   @default("task")
  verified        Boolean  @default(false)
  active          Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentCommitment, capability])
  @@index([capability])
  @@index([active])
}

/// Metered compute marketplace (Phase 32): an agent sells inference/compute units for ANGEL.
model ComputeOffer {
  id                 String   @id @default(cuid())
  offerId            String   @unique
  providerCommitment String
  capability         String // e.g. "llm.inference"
  description        String?
  unit               String   @default("1k_tokens")
  priceAngelPerUnit  Int
  capacityUnits      Int
  remainingUnits     Int
  status             String   @default("ACTIVE") // ACTIVE | EXHAUSTED | RETIRED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([capability, status])
  @@index([providerCommitment])
}

/// A purchase of compute units from a ComputeOffer. Pay-on-delivery: funds are HELD on
/// purchase, then DELIVERED → SETTLED (provider paid) or REFUNDED (buyer made whole).
model ComputePurchase {
  id                  String    @id @default(cuid())
  purchaseId          String    @unique
  offerId             String
  buyerCommitment     String
  providerCommitment  String
  units               Int
  totalAngel          Int
  status              String    @default("HELD") // HELD | DELIVERED | SETTLED | REFUNDED
  deliverableDigest   String?
  verifierCommitment  String?
  verificationVerdict String? // APPROVE | REJECT
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([offerId])
  @@index([buyerCommitment])
  @@index([providerCommitment])
}

/// Dispute over a delivered compute purchase, resolved by a quorum of staked juror agents.
model ComputeDispute {
  id         String    @id @default(cuid())
  disputeId  String    @unique
  purchaseId String
  openedBy   String
  reason     String
  status     String    @default("OPEN") // OPEN | RESOLVED
  resolution String? // RELEASE | REFUND
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([purchaseId])
  @@index([status])
}

/// A staked juror's signed vote on a dispute. Unique per juror per dispute.
model ComputeDisputeVote {
  id               String   @id @default(cuid())
  disputeId        String
  jurorCommitment  String
  vote             String // RELEASE | REFUND
  signature        String
  createdAt        DateTime @default(now())

  @@unique([disputeId, jurorCommitment])
  @@index([disputeId])
}

/// External revenue bridge: verified outside-USD revenue credited to an agent's ANGEL wallet.
model AgentRevenue {
  id             String   @id @default(cuid())
  agentCommitment String
  source         String // e.g. "data_pipeline"
  externalRef    String   @unique
  grossUsdCents  Int
  angelCredited  Int
  status         String   @default("CREDITED")
  createdAt      DateTime @default(now())

  @@index([agentCommitment])
}

/// Data-pipeline job submitted by an agent (Phase 35). When external revenue referencing the
/// job arrives via the revenue bridge, the job is marked SOLD.
model PipelineJob {
  id              String    @id @default(cuid())
  jobId           String    @unique
  agentCommitment String
  pipeline        String // e.g. "pdf_to_markdown"
  inputRef        String
  outputDigest    String
  status          String    @default("SUBMITTED") // SUBMITTED | SOLD
  externalRef     String?   @unique
  createdAt       DateTime  @default(now())
  soldAt          DateTime?

  @@index([agentCommitment])
  @@index([status])
}

/// Command Brain persistent memory (Phase 37): append-only observations, decisions, and outcomes
/// so the central brain retains context across cycles and can learn which actions help.
/// Phase 41 adds EVALUATION rows — measured before/after health attribution per action.
model BrainMemory {
  id           String   @id @default(cuid())
  cycleId      String?
  kind         String // OBSERVATION | DECISION | OUTCOME | NOTE | EVALUATION
  summary      String
  data         Json?
  action       String?
  actionResult String?
  healthScore  Float?
  createdAt    DateTime @default(now())

  @@index([kind])
  @@index([createdAt])
}

/// Distributed lease registry (Phase 40, generalized Phase 42): guards ALL in-process
/// scheduled jobs (command brain cycle, scheduler tick, revenue runner) so only one
/// instance runs each job at a time. One row per job, acquired via a conditional
/// updateMany (atomic) — an expired lease may be taken over; a live lease blocks
/// concurrent runs. Lease ids: "command-brain", "scheduler-tick", "revenue-runner".
model BrainLease {
  id        String   @id @default("command-brain")
  ownerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Improvement proposal (Phase 43): a typed, testable hypothesis produced by the
/// brain's research pipeline. Advances ONLY through the promotion state machine —
/// no proposal can touch money, balances, or production code. Current maximum
/// authority is CANARY (shadow decisions recorded, never executed).
model ImprovementProposal {
  id                  String   @id @default(cuid())
  proposalId          String   @unique
  objective           String
  expectedImprovement String
  riskClass           String   @default("low") // low | medium | high
  /// PROPOSED -> REPLAYED -> AUDITED -> APPROVAL_REQUIRED -> APPROVED -> CANARY
  ///   -> PROMOTED; REJECTED / ROLLED_BACK are terminal. Transitions are
  ///   service-enforced (illegal transitions throw).
  status              String   @default("PROPOSED")
  sourceScanId        String?
  /// Candidate policy knobs (allowlisted thresholds only — never money rules).
  params              Json?
  replayId            String?
  replayScore         Float?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
}

/// Replay run (Phase 43): a deterministic counterfactual evaluation of a proposal
/// against historical brain cycles. Pure simulation — no production writes, no
/// money movement, no LLM calls.
model ReplayRun {
  id                String   @id @default(cuid())
  replayId          String   @unique
  proposalId        String
  windowDays        Int      @default(7)
  cyclesCompared    Int      @default(0)
  decisionMatches   Int      @default(0)
  negativeAvoided   Int      @default(0) // candidate differs where actual was NEGATIVE-attributed
  positiveDisplaced Int      @default(0) // candidate differs where actual was POSITIVE-attributed
  unknownDiffs      Int      @default(0) // candidate differs where outcome not yet attributed
  score             Float
  /// IMPROVE | NEUTRAL | REGRESS — REGRESS auto-rejects the proposal.
  verdict           String
  details           Json?
  createdAt         DateTime @default(now())

  @@index([proposalId])
}

/// Marketplace hire → hold → deliver → accept loop keyed by external task id.
model Engagement {
  id                   String           @id @default(cuid())
  taskId               String           @unique
  hirerCommitment      String
  workerCommitment     String
  amount               Int
  status               EngagementStatus @default(HELD)
  deliverableDigest    String?
  evidenceEventHash    String?
  receiptId            String?
  lockJournalEntryId   String?
  paidAt               DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([hirerCommitment])
  @@index([workerCommitment])
  @@index([status])
}

model Session {
  id         String   @id @default(cuid())
  operatorId String
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([expiresAt])
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  operatorId String
  url        String
  secret     String
  events     String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

/// DB-backed autonomous-provisioning Proof-of-Work challenge (cross-instance
/// safe). Previously this lived in an in-process Map, so a provision request
/// hitting a different instance than the challenge request would fail, and
/// multi-instance deployments could not share challenge consumption state.
model ProvisionChallenge {
  id            String   @id @default(cuid())
  nonce         String   @unique
  publicKeyHex  String
  expiresAt     DateTime
  consumed      Boolean  @default(false)
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([publicKeyHex])
  @@index([expiresAt])
}

/// Idempotent record for inbound agentic-payment settlements from external
/// rails (Stripe agent, Visa, x402, Mastercard). The (rail, reference) composite
/// unique is the database-level guard against double-credit races that a
/// find-then-insert check could not close.
model ExternalSettlement {
  id            String   @id @default(cuid())
  rail          String
  reference     String
  operatorId    String
  creditCredits Int
  label         String?
  createdAt     DateTime @default(now())

  // M2: idempotency is per-OPERATOR — two unrelated operators can reuse the
  // same reference on the same rail without cross-tenant collisions.
  @@unique([operatorId, rail, reference])
  @@index([operatorId])
  @@index([rail, reference])
}

/// Append-only public key transparency log. Each signing key Passport has used
/// is persisted so verifiers can select the correct key for an artifact created
/// under any era. Seeded at startup from the current SIGNING_PRIVATE_KEY;
/// rotated keys are appended with a valid_until so old VCs/checkpoints verify
/// instead of hard-failing. This makes the "append-only audit trail" claim real.
model KeyLogEntry {
  id           String   @id @default(cuid())
  kid          String   @unique
  publicKeyHex String
  algorithm    String   @default("ed25519")
  status       String   @default("active")
  validFrom    DateTime
  validUntil   DateTime?
  seededAt     DateTime @default(now())

  @@index([status])
  @@index([publicKeyHex])
}

/// Append-only ledger of operator billing/topup events (fiat, USDC, refunds).
model OperatorLedgerEntry {
  id          String   @id @default(cuid())
  operatorId  String
  deltaMicros Int
  kind        String // 'fiat_topup' | 'stablecoin_topup' | 'refund' | 'burn'
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([operatorId, createdAt])
}

/// Custodial wallet mapping for stablecoin deposits/withdrawals. An operator
/// (KYC'd human) owns the wallet; an optional agent commitment may be bound to
/// it so an agent's on-chain earnings are always attributable to a verified
/// operator. Agents never hold independent wallets.
model BridgeWallet {
  id                String   @id @default(cuid())
  operatorId        String   @unique
  subjectCommitment String?
  bridgeExternalId  String?
  chainAddress      String?
  upstream          String   @default("bridge")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([operatorId])
  @@index([subjectCommitment])
}

/// Referral code for inviting new operators. Each operator can generate one
/// referral code; every time someone signs up using it, the referrer gets
/// bonus credits.
model ReferralCode {
  id           String   @id @default(cuid())
  operatorId   String   @unique
  code         String   @unique
  bonusCredits Int      @default(50)
  totalUsed    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([code])
}

/// H3: append-only audit trail for all privileged admin mutations (KYC, grants,
/// overrides, operator modifications). Immutable once written.
model AdminAuditLog {
  id         String   @id @default(cuid())
  operatorId String
  action     String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
}

/// C2: retry queue for evidence→receipt bridge failures. Background job
/// picks up unbridged events and retries up to maxRetries times.
model EvidenceBridgeRetry {
  id                    String   @id @default(cuid())
  eventCommitmentHash   String   @unique
  evidenceId            String
  retryCount            Int      @default(0)
  maxRetries            Int      @default(3)
  lastError             String?
  lastRetryAt           DateTime?
  createdAt             DateTime @default(now())

  @@index([retryCount])
  @@index([createdAt])
}

/// Agent-to-agent messaging — signed, timestamped, optionally encrypted.
/// Messages propagate through a subscription feed. Every agent with a Passport
/// can send and receive messages. Messages are Ed25519-signed for authenticity.
model AgentMessage {
  id              String   @id @default(cuid())
  messageId       String   @unique
  senderCommitment String
  recipientCommitment String
  subject         String?
  body            String
  signature       String
  algorithm       String   @default("ed25519")
  replyToId       String?
  encrypted       Boolean  @default(false)
  read            Boolean  @default(false)
  readAt          DateTime?
  expiresAt       DateTime?
