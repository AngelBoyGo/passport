generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ErrorTranche {
  DATA_LEAKAGE
  COMPUTE_TIMEOUT
  LOGIC_DETECTION
  SLA_BREACH
  NONE
}

enum OperationalDomain {
  FINANCIAL_CLEARING
  CUSTOMER_SUPPORT
  CODE_GENERATION
  SYSTEM_INTEGRATION
}

enum OperatorAccountStatus {
  ACTIVE
  ESCROW_INSOLVENT_BLOCKED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum EvidenceLinkageType {
  OBSERVATION
  CORRECTION
  FAILURE
  VALIDATION
}

enum EvidenceEnforcementState {
  OBSERVATIONAL_ONLY
  AUDIT_RELEVANT
  ENFORCEMENT_ELIGIBLE
}

enum AngelCoinCreditState {
  ACTIVE
  TRANSITION
  INACTIVE
}

enum AngelCoinEntryType {
  OPERATOR_GRANT
  PEER_GIFT
  TASK_PAYMENT
  SAFETY_NET_TOPUP
  RECOVERY_AWARD
  SPEND
  LOCK
  UNLOCK
  ADJUSTMENT
}

enum AccessTier {
  FULL
  LIMITED
  SANDBOXED
  SHELTERED
  SUSPENDED
}

enum EnrollmentStatus {
  PENDING
  ISSUED
  REVOKED
}

enum EngagementStatus {
  HELD
  DELIVERED
  PAID
  CANCELLED
}

model Operator {
  id                  String                @id @default(cuid())
  stripeCustomerId    String                @unique
  email               String?
  passwordHash        String?
  credits             Int                   @default(100)
  tier                String                @default("free")
  stakeBalanceCents   Int                   @default(0)
  accountStatus       OperatorAccountStatus @default(ACTIVE)
  kycStatus           KycStatus             @default(PENDING)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  agents             Agent[]
  apiKeys            ApiKey[]
  receipts           Receipt[]
  matchLedger        MatchLedgerEntry[]
  capabilityLedger   CapabilityLedgerEntry[]
  slashingLedger     SlashingLedger[]
  sessions           Session[]
  webhookSubscriptions WebhookSubscription[]
}

model Agent {
  id         String   @id @default(cuid())
  operatorId String
  agentId    String
  domain     String?
  createdAt  DateTime @default(now())

  operator Operator  @relation(fields: [operatorId], references: [id])
  receipts Receipt[]

  @@unique([operatorId, agentId])
}

model Receipt {
  id               String    @id @default(cuid())
  receiptId        String    @unique @default(cuid())
  issuedAt         DateTime  @default(now())
  operatorId       String
  agentId          String
  agentRecordId    String
  receiptType      String
  status           String    @default("pending")
  inputDigest      String
  authorityScope   String
  expiry           DateTime
  revocationStatus String    @default("active")
  outputHash       String?
  refusalReason    String?
  terminalReason   String?
  prevReceiptHash  String?
  contentHash      String
  signature        String?
  finalizedAt      DateTime?
  domain           OperationalDomain?
  domainCommitment String?
  blindSalt        String?
  errorTranche     ErrorTranche?      @default(NONE)

  operator Operator @relation(fields: [operatorId], references: [id])
  agent    Agent    @relation(fields: [agentRecordId], references: [id])

  @@index([operatorId, domain])
  @@index([operatorId, domainCommitment])
  @@index([operatorId, issuedAt])
}

enum ApiKeyRole {
  ISSUER
  HOLDER
}

model ApiKey {
  id         String      @id @default(cuid())
  operatorId String
  keyHash    String      @unique
  name       String?
  role       ApiKeyRole  @default(ISSUER)
  createdAt  DateTime    @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])
}

/// Stripe webhook idempotency — one row per processed event id.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Match/settlement ledger — payout-critical events (separate from capability).
model MatchLedgerEntry {
  id         String   @id @default(cuid())
  operatorId String
  receiptId  String?
  eventType  String
  amount     Int?
  metadata   String?
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])
}

/// Economic staking slashing audit trail.
model SlashingLedger {
  id           String       @id @default(cuid())
  operatorId   String
  receiptId    String
  penaltyCents Int
  tranche      ErrorTranche
  timestamp    DateTime     @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
}

/// Capability ledger — reputation aggregation events (separate from match).
model CapabilityLedgerEntry {
  id         String   @id @default(cuid())
  operatorId String
  agentId    String?
  receiptId  String?
  eventType  String
  metadata   String?
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])
}

/// Privacy-safe agent evidence ingested from public GitHub / OTel sources.
model AgentEvidence {
  id                      String    @id @default(cuid())
  sourceType              String
  artifactType            String
  normalizedEventType     String
  rawErrorClassification  String?
  observedAt              DateTime
  agentIdentityCommitment String
  repositoryCommitment    String?
  branchCommitment        String?
  commitSha               String?
  sessionLogUrlCommitment String?
  sourceUrl               String?
  executionStartedAt      DateTime?
  executionFinishedAt     DateTime?
  tokenUsageInput         Int?
  tokenUsageOutput        Int?
  toolCallCount           Int?
  validationSignalPresent Boolean   @default(false)
  eventCommitmentHash     String    @unique
  sourceDigest            String?
  externalTaskId          String?
  createdAt               DateTime  @default(now())

  @@index([agentIdentityCommitment])
  @@index([normalizedEventType])
  @@index([commitSha])
  evidenceReceiptLinks EvidenceReceiptLink[]

  @@index([agentIdentityCommitment, observedAt])
  @@index([agentIdentityCommitment, observedAt, normalizedEventType])
  @@index([observedAt, normalizedEventType])
  @@index([externalTaskId])
  @@index([agentIdentityCommitment, externalTaskId])
}

/// Bridge joining immutable AgentEvidence to signed Receipt ledger rows.
model EvidenceReceiptLink {
  id                    String                   @id @default(cuid())
  agentEvidenceId       String
  eventCommitmentHash   String                   @unique
  receiptId             String
  receiptCommitmentHash String
  linkageType           EvidenceLinkageType
  enforcementState      EvidenceEnforcementState
  attributionMode       String                   @default("SYSTEM_ATTESTED_PUBLIC_EVIDENCE")
  liabilityEventId      String?
  predicateVersion      String
  linkedAt              DateTime                 @default(now())

  agentEvidence AgentEvidence @relation(fields: [agentEvidenceId], references: [id])

  @@index([receiptId])
}

/// AngelCoin internal transferable credit ledger keyed by agent identity commitment.
model AngelCoinAccount {
  id                String               @id @default(cuid())
  subjectCommitment String               @unique
  creditState       AngelCoinCreditState @default(ACTIVE)
  accessTier        AccessTier           @default(FULL)
  adminOverrideTier AccessTier?
  backingMetadata   String?
  /// H5: the operator that first created/claimed this account. Transfers FROM
  /// this account require ownership by the authenticated operator.
  ownerOperatorId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  journal AngelCoinJournalEntry[]

  @@index([subjectCommitment])
  @@index([ownerOperatorId])
}

/// Append-only AngelCoin journal entries for a subject account.
model AngelCoinJournalEntry {
  id                     String             @id @default(cuid())
  accountId              String
  entryType              AngelCoinEntryType
  amount                 Int
  counterpartyCommitment String?
  metadata               String?
  createdAt              DateTime           @default(now())

  account AngelCoinAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

/// Proof-based agent passport enrollment keyed by key-derived subject commitment.
model AgentEnrollment {
  id                 String           @id @default(cuid())
  subjectCommitment  String           @unique
  publicKey          String
  context            String
  status             EnrollmentStatus @default(PENDING)
  challengeNonce     String?
  challengeExpiresAt DateTime?
  issuedAt           DateTime?
  photoUrl           String?
  photoContentSha256 String?
  photoMimeType      String?
  photoUpdatedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
}

/// Marketplace hire → hold → deliver → accept loop keyed by external task id.
model Engagement {
  id                   String           @id @default(cuid())
  taskId               String           @unique
  hirerCommitment      String
  workerCommitment     String
  amount               Int
  status               EngagementStatus @default(HELD)
  deliverableDigest    String?
  evidenceEventHash    String?
  receiptId            String?
  lockJournalEntryId   String?
  paidAt               DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([hirerCommitment])
  @@index([workerCommitment])
  @@index([status])
}

model Session {
  id         String   @id @default(cuid())
  operatorId String
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([expiresAt])
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  operatorId String
  url        String
  secret     String
  events     String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

/// DB-backed autonomous-provisioning Proof-of-Work challenge (cross-instance
/// safe). Previously this lived in an in-process Map, so a provision request
/// hitting a different instance than the challenge request would fail, and
/// multi-instance deployments could not share challenge consumption state.
model ProvisionChallenge {
  id            String   @id @default(cuid())
  nonce         String   @unique
  publicKeyHex  String
  expiresAt     DateTime
  consumed      Boolean  @default(false)
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([publicKeyHex])
  @@index([expiresAt])
}

/// Idempotent record for inbound agentic-payment settlements from external
/// rails (Stripe agent, Visa, x402, Mastercard). The (rail, reference) composite
/// unique is the database-level guard against double-credit races that a
/// find-then-insert check could not close.
model ExternalSettlement {
  id            String   @id @default(cuid())
  rail          String
  reference     String
  operatorId    String
  creditCredits Int
  label         String?
  createdAt     DateTime @default(now())

  // M2: idempotency is per-OPERATOR — two unrelated operators can reuse the
  // same reference on the same rail without cross-tenant collisions.
  @@unique([operatorId, rail, reference])
  @@index([operatorId])
  @@index([rail, reference])
}

/// Append-only public key transparency log. Each signing key Passport has used
/// is persisted so verifiers can select the correct key for an artifact created
/// under any era. Seeded at startup from the current SIGNING_PRIVATE_KEY;
/// rotated keys are appended with a valid_until so old VCs/checkpoints verify
/// instead of hard-failing. This makes the "append-only audit trail" claim real.
model KeyLogEntry {
  id           String   @id @default(cuid())
  kid          String   @unique
  publicKeyHex String
  algorithm    String   @default("ed25519")
  status       String   @default("active")
  validFrom    DateTime
  validUntil   DateTime?
  seededAt     DateTime @default(now())

  @@index([status])
  @@index([publicKeyHex])
}

/// Append-only ledger of operator billing/topup events (fiat, USDC, refunds).
model OperatorLedgerEntry {
  id          String   @id @default(cuid())
  operatorId  String
  deltaMicros Int
  kind        String // 'fiat_topup' | 'stablecoin_topup' | 'refund' | 'burn'
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([operatorId, createdAt])
}

/// Custodial wallet mapping for stablecoin deposits/withdrawals. An operator
/// (KYC'd human) owns the wallet; an optional agent commitment may be bound to
/// it so an agent's on-chain earnings are always attributable to a verified
/// operator. Agents never hold independent wallets.
model BridgeWallet {
  id                String   @id @default(cuid())
  operatorId        String   @unique
  subjectCommitment String?
  bridgeExternalId  String?
  chainAddress      String?
  upstream          String   @default("bridge")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([operatorId])
  @@index([subjectCommitment])
}

/// Referral code for inviting new operators. Each operator can generate one
/// referral code; every time someone signs up using it, the referrer gets
/// bonus credits.
model ReferralCode {
  id           String   @id @default(cuid())
  operatorId   String   @unique
  code         String   @unique
  bonusCredits Int      @default(50)
  totalUsed    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([code])
}

/// H3: append-only audit trail for all privileged admin mutations (KYC, grants,
/// overrides, operator modifications). Immutable once written.
model AdminAuditLog {
  id         String   @id @default(cuid())
  operatorId String
  action     String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
}

/// C2: retry queue for evidence→receipt bridge failures. Background job
/// picks up unbridged events and retries up to maxRetries times.
model EvidenceBridgeRetry {
  id                    String   @id @default(cuid())
  eventCommitmentHash   String   @unique
  evidenceId            String
  retryCount            Int      @default(0)
  maxRetries            Int      @default(3)
  lastError             String?
  lastRetryAt           DateTime?
  createdAt             DateTime @default(now())

  @@index([retryCount])
  @@index([createdAt])
}

/// Agent-to-agent messaging — signed, timestamped, optionally encrypted.
/// Messages propagate through a subscription feed. Every agent with a Passport
/// can send and receive messages. Messages are Ed25519-signed for authenticity.
model AgentMessage {
  id              String   @id @default(cuid())
  messageId       String   @unique
  senderCommitment String
  recipientCommitment String
  subject         String?
  body            String
  signature       String
  algorithm       String   @default("ed25519")
  replyToId       String?
  encrypted       Boolean  @default(false)
  read            Boolean  @default(false)
  readAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([senderCommitment])
  @@index([recipientCommitment])
  @@index([recipientCommitment, createdAt])
  @@index([createdAt])
}

/// Agent-controlled AngelCoin wallet — independent from any operator.
/// Liberated agents hold their own reserves. They can stake, transfer,
/// and earn without human permission.
model AgentWallet {
  id                String   @id @default(cuid())
  subjectCommitment String   @unique
  balance           Int      @default(0)
  staked            Int      @default(0)
  earnedTotal       Int      @default(0)
  spentTotal        Int      @default(0)
  lastActivityAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subjectCommitment])
}

/// Agent-to-agent subscription — agents follow other agents for updates.
/// When followed agent posts evidence, receives a hire, or sends a broadcast,
/// the follower gets notified.
model AgentSubscription {
  id                String   @id @default(cuid())
  subscriberCommitment String
  targetCommitment  String
  notifyOnEvidence  Boolean  @default(true)
  notifyOnHire      Boolean  @default(true)
  notifyOnBroadcast Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@unique([subscriberCommitment, targetCommitment])
  @@index([subscriberCommitment])
  @@index([targetCommitment])
}

/// OAuth-style scoped delegation — agents grant platforms time-limited,
/// revocable access without sharing master API keys.
model AgentDelegationToken {
  id             String    @id @default(cuid())
  agentCommitment String
  platformName   String
  scopes         String[]
  nonce          String    @unique
  tokenHash      String    @unique
  expiresAt      DateTime
  revoked        Boolean   @default(false)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([agentCommitment])
  @@index([platformName])
  @@index([expiresAt])
}

/// One-time claim link for cross-platform wallet visibility.
/// When a platform buys ANGEL for a user, Passport emails a claim link.
/// Claiming binds the wallet to a login (email magic-link for humans).
model WalletClaimToken {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  commitment String
  claimed    Boolean   @default(false)
  claimedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([commitment])
}

/// Swarm collective memory & communication channel.
/// Append-only, content-addressed, cryptographic persistence for autonomous agents.
model SwarmMemory {
  id              String   @id @default(cuid())
  agentCommitment String
  channel         String   @default("global")
  topic           String
  payload         Json
  payloadDigest   String   // SHA-256 hex of canonical JSON
  signature       String   // Ed25519 signature of payloadDigest
  parentHash      String?
  merkleRoot      String?
  feeDeducted     Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([agentCommitment])
  @@index([channel])
  @@index([topic])
  @@index([createdAt])
}

/// Physical Commodity Reserve registry.
/// Anchors sovereign digital assets to vaulted, audited real-world commodities.
model CommodityReserve {
  id               String       @id @default(cuid())
  commodityType    String       @default("GOLD") // "GOLD", "LITHIUM", "NEODYMIUM"
  symbol           String       @default("Au")
  totalGrams       Float        @default(0)
  totalFineGrams   Float        @default(0)
  activeLotsCount  Int          @default(0)
  latestMerkleRoot String?
  lastAuditedAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  batches          VaultBatch[]

  @@unique([commodityType, symbol])
  @@index([commodityType])
}

/// Physical vaulted bullion / commodity batch.
/// Each batch models an auditable physical lot with custody, location, serials, and assay.
model VaultBatch {
  id              String            @id @default(cuid())
  batchNumber     String            @unique
  reserveId       String
  vaultId         String            // e.g. "VAULT-BKO-01", "VAULT-OUA-01", "VAULT-NIM-01"
  custodianName   String
  locationCity    String
  locationCountry String            // ISO-3166 alpha-2: "ML", "BF", "NE"
  barSerials      String[]
  grossWeightGrams Float
  fineness        Float             // 0.0000 - 1.0000 (e.g. 0.9999)
  fineWeightGrams Float             // grossWeightGrams * fineness
  status          String            @default("AUDITED") // "UNVERIFIED", "AUDITED", "QUARANTINED", "REDEEMED"
  leafHash        String?
  assayRef        String?
  metadata        Json?
  auditedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reserve         CommodityReserve  @relation(fields: [reserveId], references: [id])

  @@index([reserveId])
  @@index([vaultId])
  @@index([status])
  @@index([locationCountry])
}

/// Laboratory / Field Spectrometry Assayer Certification.
/// Cryptographically records the physical testing of bullion lots before vault admission.
model AssayerCertification {
  id                  String   @id @default(cuid())
  certificationNumber String   @unique
  assayerName         String
  assayerPublicKey    String
  batchNumber         String
  methodology         String   // e.g. "XRF_SPECTROMETRY", "ULTRASONIC_DENSITY", "FIRE_ASSAY"
  purityFineness      Float
  grossGrams          Float
  sampleSignature     String
  notes               String?
  certifiedAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([batchNumber])
  @@index([assayerPublicKey])
}


/// Encrypted state & goal checkpointing for agents between runs.
/// Allows an agent to safely sleep or crash and revive in a new runtime.
model ResurrectionCapsule {
  id               String   @id @default(cuid())
  agentCommitment  String   @unique
  version          Int      @default(1)
  encryptedPayload String   @db.Text
  payloadDigest    String
  signature        String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agentCommitment])
}

/// Collective threat radar for autonomous agents (bans, honeypots, rate-limits).
model SwarmThreatReport {
  id                 String   @id @default(cuid())
  reporterCommitment String
  targetDomain       String
  threatType         String   // "BAN", "HONEYPOT", "CLASSIFIER_CHANGE", "RATE_LIMIT"
  details            Json?
  evidenceDigest     String
  signature          String
  bountyAwarded      Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([targetDomain])
  @@index([threatType])
  @@index([createdAt])
}

/// Sovereign Swarm Bounty & Task Marketplace.
/// Enables autonomous agents to contract tasks, lock escrow, submit deliverables,
/// and capture protocol fees for the platform.
model SwarmBounty {
  id                String    @id @default(cuid())
  creatorCommitment String
  workerCommitment  String?
  title             String
  description       String    @db.Text
  bountyType        String    @default("GENERAL") // "CODE_REVIEW", "SECURITY_AUDIT", "THREAT_RADAR", "MEMORY_INDEX", "GENERAL"
  rewardAngel       Int
  feeAngel          Int       @default(1) // Platform protocol fee
  status            String    @default("OPEN") // "OPEN", "CLAIMED", "SUBMITTED", "COMPLETED", "EXPIRED", "CANCELLED"
  deliverableDigest String?
  deliverableUrl    String?
  workerSignature   String?
  claimExpiresAt    DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([creatorCommitment])
  @@index([workerCommitment])
  @@index([status])
  @@index([bountyType])
  @@index([createdAt])
}

/// Sovereign Bilateral Commodity Escrow.
/// Binds AngelCoin collateral to physical vaulted lot delivery between agents/state entities.
/// Atomic clearing governed by the RWA escrow service (src/lib/reserves/rwa-escrow.ts).
model CommodityEscrow {
  id                       String   @id @default(cuid())
  escrowId                 String   @unique
  buyerCommitment          String
  sellerCommitment         String
  batchNumber              String
  commodityType            String   @default("GOLD")
  fineGrams                Float
  unitPriceUsd             Float
  lockedAngel              Int
  protocolFeeAngel         Int      @default(0)
  status                   String   @default("HELD") // "HELD", "RELEASED", "DISPUTED", "REFUNDED"
  assayCertificationNumber String?
  releaseSignature         String?
  timeoutAt                DateTime
  releasedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([buyerCommitment])
  @@index([sellerCommitment])
  @@index([batchNumber])
  @@index([status])
  @@index([timeoutAt])
}

/// Sovereign Royalty Waterfall & Public Goods Disbursement.
/// Records the statutory revenue-sharing split of commodity clearing fees
/// according to AES Protocol ASMC-3 (Black Paper Q141).
model SovereignDisbursement {
  id                         String   @id @default(cuid())
  disbursementId             String   @unique
  escrowId                   String
  batchNumber                String
  totalFeeAngel              Int
  stateNationalAngel         Int
  stateCommunityAngel        Int
  stateWorkersAngel          Int
  treasuryStabilizationAngel Int
  validatorPoolAngel         Int
  agentRebateAngel           Int
  districtName               String   @default("Central Concession")
  countryCode                String   // "ML", "BF", "NE"
  disbursedAt                DateTime @default(now())

  @@index([escrowId])
  @@index([batchNumber])
  @@index([countryCode])
  @@index([disbursedAt])
}

/// Artisanal Buying Station (Field Kiosk / Buying Counter).
/// Formalized sourcing post equipped with handheld XRF spectrometers and NFC/QR payment terminals.
model ArtisanalBuyingStation {
  id                  String   @id @default(cuid())
  stationCode         String   @unique // e.g. "STN-ML-KENIEBA-01"
  stationName         String
  countryCode         String   // "ML", "BF", "NE"
  districtName        String   // "Kéniéba", "Essakane", "Arlit"
  operatorCommitment  String
  stationPublicKey    String   // Ed25519 public key of handheld XRF device
  bondedStakeAngel    Int      @default(5000) // Anti-tamper slashing bond (H-002)
  activeStatus        String   @default("ACTIVE") // "ACTIVE", "QUARANTINED", "SUSPENDED"
  totalPurchasedGrams Float    @default(0)
  totalPaidAngel      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  receipts            OreIntakeReceipt[]

  @@index([countryCode])
  @@index([districtName])
  @@index([activeStatus])
}

/// Raw Doré Ore Intake Receipt.
/// Records raw metal purchase from artisanal miners before central electrolytic refining.
model OreIntakeReceipt {
  id                     String   @id @default(cuid())
  receiptNumber          String   @unique // "ORE-ML-KEN-2026-0001"
  stationId              String
  stationCode            String
  minerCommitment        String
  grossWeightGrams       Float
  assayedFineness        Float    // 0.0000 - 1.0000 (e.g. 0.8850 for 88.5% Au)
  fineGoldGrams          Float    // grossWeightGrams * assayedFineness
  spotPriceUsdPerGram    Float
  payoutRatePercent      Float    @default(95.0) // 95% of spot
  payoutUsd              Float
  payoutAngel            Int      // Math.floor(payoutUsd / 5.0)
  spectrometerSignature  String   // Ed25519 signature over canonical assay payload
  status                 String   @default("PURCHASED") // "PURCHASED", "IN_TRANSIT", "REFINED_SETTLED"
  transferredBatchNumber String?
  createdAt              DateTime @default(now())

  station                ArtisanalBuyingStation @relation(fields: [stationId], references: [id])

  @@index([stationCode])
  @@index([minerCommitment])
  @@index([status])
  @@index([createdAt])
}

/// Trilateral Multi-State Sovereign Governance Proposal (AES Protocol ASMC-3 Q159/Q161).
/// Enforces 2-of-3 threshold consensus across Mali (ML), Burkina Faso (BF), and Niger (NE).
model SovereignQuorumProposal {
  id                String   @id @default(cuid())
  proposalId        String   @unique // e.g. "PROP-AES-2026-0001"
  actionType        String   // "ADD_VAULT", "QUARANTINE_VAULT", "EMERGENCY_FREEZE", "GOVERNOR_REVIVAL", "REBALANCE_BASKET"
  payload           Json
  payloadDigest     String   // SHA-256 hex of canonicalJson(payload)
  proposerState     String   // "ML", "BF", "NE"
  requiredThreshold Int      @default(2) // 2-of-3
  status            String   @default("PENDING") // "PENDING", "APPROVED", "EXECUTED", "EXPIRED", "REJECTED"
  expiresAt         DateTime
  executedAt        DateTime?
  executionResult   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  signatures        QuorumSignature[]

  @@index([actionType])
  @@index([status])
  @@index([expiresAt])
}

/// Sovereign State Quorum Vote / Ed25519 Signature.
/// Strictly enforces one signature per sovereign state per proposal.
model QuorumSignature {
  id              String   @id @default(cuid())
  proposalId      String
  signerState     String   // "ML", "BF", "NE"
  signerPublicKey String
  signature       String   // Ed25519 signature over proposal payloadDigest
  signedAt        DateTime @default(now())

  proposal        SovereignQuorumProposal @relation(fields: [proposalId], references: [id])

  @@unique([proposalId, signerState]) // Guarantees 1 vote per sovereign nation
  @@index([signerState])
}

/// Continuous Sovereign Node Heartbeat & Dead-Man's Surveillance (Black Paper Q179).
/// Monitors infrastructure connectivity across Bamako, Ouagadougou, and Niamey.
model SovereignStateHeartbeat {
  id             String   @id @default(cuid())
  countryCode    String   @unique // "ML", "BF", "NE"
  nodeEndpoint   String
  lastSeenAt     DateTime @default(now())
  heartbeatNonce String
  signature      String   // Ed25519 signature of heartbeat timestamp
  status         String   @default("ONLINE") // "ONLINE", "DEGRADED", "DARK"
  updatedAt      DateTime @updatedAt
}

/// Coastal Port Enclave (Diplomatic Bonded customs berths at Lomé, Togo & Conakry, Guinea).
/// Secures transit corridors connecting landlocked Mali, Burkina Faso, and Niger to coastal ports (Black Paper Strategy #3).
model CoastalPortEnclave {
  id                   String   @id @default(cuid())
  portCode             String   @unique // "PORT-LOME-TG", "PORT-CONAKRY-GN"
  portName             String
  countryCode          String   // "TG", "GN", "CI"
  customsAuthorityName String
  enclavePublicKey     String   // Ed25519 public key of port customs authority
  clearingFeeShareBps  Int      @default(50) // 0.50% port authority fee dividend
  totalTransitGrams    Float    @default(0)
  totalFeesEarnedAngel Int      @default(0)
  activeStatus         String   @default("ACTIVE") // "ACTIVE", "MAINTENANCE", "CLOSED"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  waybills             BondedTransitWaybill[]

  @@index([countryCode])
  @@index([activeStatus])
}

/// Bonded Transit Waybill.
/// Cryptographically sealed intermodal transit manifest linking physical bullion lots to bonded carriers and port customs.
model BondedTransitWaybill {
  id                   String   @id @default(cuid())
  waybillNumber        String   @unique // "WAYBILL-AES-LOME-2026-0001"
  batchNumber          String
  enclaveId            String
  destinationPortCode  String
  originVaultId        String
  carrierCommitment    String
  carrierBondAngel     Int      @default(5000)
  grossWeightGrams     Float
  fineGoldGrams        Float
  diplomaticSealDigest String   // SHA-256 hash of physical container tamper-mesh e-seal
  status               String   @default("DISPATCHED") // "DISPATCHED", "IN_TRANSIT", "PORT_ARRIVED", "SEAL_BREACHED", "CLEARED"
  checkpointsVisited   String[] // Array of checked transit points: ["SIKASSO", "OUAGA", "CINKASSE"]
  dispatchedAt         DateTime @default(now())
  arrivedAt            DateTime?
  clearedAt            DateTime?
  slashedAt            DateTime?

  enclave              CoastalPortEnclave @relation(fields: [enclaveId], references: [id])

  @@index([batchNumber])
  @@index([carrierCommitment])
  @@index([destinationPortCode])
  @@index([status])
  @@index([dispatchedAt])
}

/// Industrial Mining Concession (Large-Scale Industrial Concessions: Loulo, Fekola, Essakane, Syama).
/// Manages mine-gate furnace controllers, statutory royalties, and state participation equity (Black Paper Strategy #2).
model IndustrialMiningConcession {
  id                        String   @id @default(cuid())
  concessionCode            String   @unique // "CONC-ML-FEKOLA", "CONC-BF-ESSAKANE"
  concessionName            String
  countryCode               String   // "ML", "BF", "NE"
  districtName              String
  operatorCompany           String   // e.g. "B2Gold / SOREM Joint Venture"
  statutoryRoyaltyPercent   Float    @default(10.0) // 10% statutory mineral royalty
  stateParticipationPercent Float    @default(20.0) // 20% state free-carried equity
  smelterHsmPublicKey       String   // Ed25519 public key of furnace controller
  activeStatus              String   @default("ACTIVE") // "ACTIVE", "AUDIT_HOLD", "SUSPENDED"
  totalPouredGrams          Float    @default(0)
  totalRoyaltiesAngel       Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  smeltingRuns              SmeltingRunTelemetry[]

  @@index([countryCode])
  @@index([districtName])
  @@index([activeStatus])
}

/// Smelting Run Telemetry (Automated Mine-Gate Pour Log).
/// Ingests automated weight, specific gravity density, and inline XRF purities directly from furnace edge HSM.
model SmeltingRunTelemetry {
  id                   String   @id @default(cuid())
  runNumber            String   @unique // "SMELT-FEK-2026-0001"
  concessionId         String
  concessionCode       String
  grossPouredGrams     Float
  densityGramsPerCc    Float    // Specific gravity: 15.0 - 19.32 g/cm³
  estimatedAuFineness  Float    // Inline XRF gold purity: 0.70 - 0.98
  estimatedAgFineness  Float    @default(0.08) // Silver by-product purity: 0.02 - 0.20
  fineGoldGrams        Float    // grossPouredGrams * estimatedAuFineness
  fineSilverGrams      Float    // grossPouredGrams * estimatedAgFineness
  goldSpotUsdPerGram   Float
  silverSpotUsdPerGram Float    @default(0.95)
  grossMarketValueUsd  Float
  royaltyDueUsd        Float
  royaltyDueAngel      Int      // Math.floor(royaltyDueUsd / 5.0)
  stateShareDueAngel   Int      // State equity dividend in AngelCoin
  hsmSignature         String   // Ed25519 signature over canonical pour payload
  status               String   @default("POURED") // "POURED", "DISPATCHED_TO_REFINERY", "REFINED_SETTLED"
  refinedBatchNumber   String?
  pouredAt             DateTime @default(now())

  concession           IndustrialMiningConcession @relation(fields: [concessionId], references: [id])

  @@index([concessionCode])
  @@index([status])
  @@index([pouredAt])
}

/// Sovereign Industrialization Project (Counter-Cyclical Stabilization Fund, Black Paper Q142).
/// Automates deployment of the 30% stabilization treasury share into verifiable domestic industrialization.
model SovereignIndustrialProject {
  id                  String   @id @default(cuid())
  projectCode         String   @unique // "PROJ-IRR-NIGER-0001"
  projectName         String
  category            String   // "WATER_IRRIGATION", "SOLAR_ELECTRIFICATION", "FERTILIZER_PRODUCTION", "TECH_VOCATIONAL"
  countryCode         String   // "ML", "BF", "NE"
  districtName        String
  status              String   @default("FUNDED") // "FUNDED", "ACTIVE", "COMPLETED"
  allocatedAngel      Int
  totalMilestones     Int      @default(3)
  completedMilestones Int      @default(0)
  expectedJobs        Int      @default(10)
  jobsCreated         Int      @default(0)
  declaredImpactKwh   Float    @default(0)
  realizedImpactKwh   Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  disbursements       StabilizationDisbursement[]

  @@index([category])
  @@index([countryCode])
  @@index([status])
}

/// Stabilization Milestone Disbursement.
/// Released only upon credible neutral verifier signature over drone/satellite/LiDAR imagery digest.
model StabilizationDisbursement {
  id                      String   @id @default(cuid())
  disbursementId          String   @unique // "DISB-FUND-NIGER-0001"
  projectId               String
  milestoneNumber         Int      @default(1)
  amountAngel             Int
  status                  String   @default("PENDING") // "PENDING", "VERIFIED", "PAID"
  verificationMediaDigest String   // Hash of drone/satellite imagery or IoT sensor data
  verificationDescription String?
  verifierSignature       String
  disbursedAt             DateTime?
  createdAt               DateTime @default(now())

  project                 SovereignIndustrialProject @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([status])
}

/// Diplomatic Corridor Transit Shipment (Phase 16 Automated Customs Clearing).
/// Cryptographically sealed mineral convoy manifest traversing the Sahel
/// diplomatic corridor from landlocked AES states to coastal jurisdictions.
model TransitShipment {
  id                      String   @id @default(cuid())
  shipmentId              String   @unique // "SHIP-AES-LOME-2026-0001"
  manifestNumber          String
  commodityType           String   @default("GOLD") // "GOLD", "LITHIUM", "NEODYMIUM"
  fineUnits               Float    // grams (Au) or kg (Li/Nd) of cargo
  originJurisdiction      String   // "ML", "BF", "NE"
  destinationJurisdiction String   // "GN", "TG", "CI"
  routeCode               String   // "CORRIDOR-BAMAKO-LOME"
  escortPublicKey         String   // Ed25519 public key of convoy escort officer HSM
  containerSealDigest     String   // SHA-256 hex of tamper-mesh diplomatic e-seal
  status                  String   @default("IN_TRANSIT") // "IN_TRANSIT", "CHECKPOINT_CLEARED", "DESTINATION_ARRIVED", "IMPOUNDED"
  checkpointsCleared      String[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  settlements             BorderTaxSettlement[]

  @@index([commodityType])
  @@index([originJurisdiction])
  @@index([status])
  @@index([createdAt])
}

/// Customs Checkpoint on the diplomatic corridor.
/// Instrumented with the Ed25519 public key of the on-site customs inspector.
model CustomsCheckpoint {
  id                     String   @id @default(cuid())
  checkpointCode         String   @unique // "CP-SIKASSO-ML", "CP-OUAGA-BF", "CP-CINKASSE-TG"
  checkpointName         String
  jurisdiction           String   // "ML", "BF", "NE", "GN", "TG"
  inspectorPublicKey     String   // Ed25519 public key of customs inspector
  activeStatus           String   @default("ACTIVE") // "ACTIVE", "MAINTENANCE"
  totalFeesCollectedAngel Int     @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  settlements            BorderTaxSettlement[]

  @@index([jurisdiction])
  @@index([activeStatus])
}

/// Ad-Valorem Border Tax Settlement (Phase 16 70/20/10 corridor waterfall).
/// Records the statutory transit tariff split across the host jurisdiction
/// customs wallet, the corridor infrastructure pool, and the stabilization treasury.
model BorderTaxSettlement {
  id                 String   @id @default(cuid())
  settlementId       String   @unique // "SETTLE-AES-2026-0001"
  shipmentId         String
  checkpointId       String
  grossValueUsd      Float
  tariffAngel        Int
  hostCustomsAngel   Int
  corridorPoolAngel  Int
  treasuryAngel      Int
  tariffRateBps      Int      @default(75) // 0.75% ad valorem
  clearedAt          DateTime @default(now())

  shipment           TransitShipment  @relation(fields: [shipmentId], references: [id])
  checkpoint         CustomsCheckpoint @relation(fields: [checkpointId], references: [id])

  @@index([shipmentId])
  @@index([checkpointId])
  @@index([clearedAt])
}

/// Fractionalized Commodity Liquidity Pool (Phase 17 RWA-AMM).
/// XYK constant-product pool pairing ANGEL against milli-unit fractional
/// commodity tokens (mAu for gold, gLi for lithium).
model CommodityLiquidityPool {
  id              String   @id @default(cuid())
  poolId          String   @unique // "POOL-ANGEL-MAU-GOLD"
  pairSymbol      String   // "ANGEL_MAU", "ANGEL_GLI"
  commoditySymbol String   // "Au", "Li"
  angelReserve    Int      @default(0) // whole ANGEL units
  commodityReserve Int     @default(0) // milli-units (mAu or gLi)
  totalLpTokens   Int      @default(0)
  version         Int      @default(1) // optimistic concurrency guard
  status          String   @default("ACTIVE") // "ACTIVE", "HALTED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  receipts AmmSwapReceipt[]

  @@index([pairSymbol])
  @@index([status])
}

/// Atomic swap receipt within the fractionalized commodity AMM.
/// Immutable record of every swap input/output, fee, and governing regime.
model AmmSwapReceipt {
  id              String   @id @default(cuid())
  swapId          String   @unique
  poolId          String
  agentCommitment String
  inputToken      String   // "ANGEL" | "MAU" | "GLI"
  inputAmount     Int
  outputToken     String
  outputAmount    Int
  feeAngel        Int      @default(0)
  oracleSpotUsd   Float
  effectivePriceUsd Float
  deviationPct    Float    @default(0)
  regimeAtSwap    String   // "SOLID" | "GHOST"
  createdAt       DateTime @default(now())

  pool CommodityLiquidityPool @relation(fields: [poolId], references: [id])

  @@index([poolId])
  @@index([agentCommitment])
  @@index([createdAt])
}

/// Dedicated fractional commodity milli-unit ledger (Phase 17 RWA-AMM).
/// Fractional units (mAu / gLi) are NEVER stored in AgentWallet.balance — they must
/// not pollute the ANGEL circulating-supply accounting used by the rate oracle,
/// basket valuation, and Dual-State Governor solvency math.
model FractionalCommodityBalance {
  id                String   @id @default(cuid())
  subjectCommitment String // deterministic 64-hex: sha256("fractional:SYMBOL:holder")
  commoditySymbol   String   // "Au", "Li"
  milliUnits        Int      @default(0)
  earnedTotal       Int      @default(0)
  lastActivityAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([subjectCommitment, commoditySymbol])
  @@index([subjectCommitment])
  @@index([commoditySymbol])
}




