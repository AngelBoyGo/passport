}

/// Dedicated fractional commodity milli-unit ledger (Phase 17 RWA-AMM).
/// Fractional units (mAu / gLi) are NEVER stored in AgentWallet.balance — they must
/// not pollute the ANGEL circulating-supply accounting used by the rate oracle,
/// basket valuation, and Dual-State Governor solvency math.
model FractionalCommodityBalance {
  id                String   @id @default(cuid())
  subjectCommitment String // deterministic 64-hex: sha256("fractional:SYMBOL:holder")
  commoditySymbol   String   // "Au", "Li"
  milliUnits        Int      @default(0)
  earnedTotal       Int      @default(0)
  lastActivityAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([subjectCommitment, commoditySymbol])
  @@index([subjectCommitment])
  @@index([commoditySymbol])
}

/// Idempotent mobile-money settlement (Phase 18 Sahel Digital Money Gateway).
/// The (provider, externalRef) composite unique is the database-level guard against
/// double-credit: a redelivered mobile-money callback finds the row and returns the
/// ORIGINAL event instead of re-crediting.
model MoneySettlement {
  id             String   @id @default(cuid())
  provider       String   // "orangemoney" | "moov" | "momo" | "agent_api"
  externalRef    String
  xofAmount      Int
  xofRateUsd     Float     // FiatFix rate captured at settlement time
  creditedAngel  Int
  targetCommitment String // deterministic collector wallet or agent commitment
  status         String   @default("SETTLED") // "SETTLED", "PENDING_REVIEW"
  metadata       String?  // canonical callback payload (sans signature)
  createdAt      DateTime @default(now())
  settledAt      DateTime?

  @@unique([provider, externalRef])
  @@index([provider])
  @@index([createdAt])
}

/// Fiat exchange-rate fix for the Sahel on-ramp (Phase 18).
/// XOF (FCFA) → USD price fix refreshed by a scheduler. Staleness (>24h) and an
/// out-of-band guard (±2.5% against a configured reference) refuse on-ramp so no
/// arbitrage window opens against a dirty rate.
model FiatFix {
  id            String   @id @default(cuid())
  currency      String   // "XOF"
  rateUsdPerUnit Float
  source        String
  validFrom     DateTime @default(now())
  expiresAt     DateTime

  @@index([currency, validFrom])
  @@index([currency, expiresAt])
}

/// Rail Factory — a discovered/provisioned settlement rail (Phase 19).
/// A rail is a typed, versioned, lifecycle-managed settlement channel. Every state
/// transition is atomic (updateMany status+version guard) and money-touching actions
/// are audit-logged.
model RailSpec {
  id                 String   @id @default(cuid())
  railKey            String   @unique
  name               String
  category           String   // "PAYMENT" | "AGRI" | "ENERGY" | "CORRIDOR" | "AGENT_PAYROLL"
  providerKey        String
  ledgerKind         String   // "ANGEL" | "FRACTIONAL" | "LP" | "STATE"
  kycTier            String   @default("NONE") // "NONE" | "IDENTITY" | "KYC1" | "KYC2"
  feeBps             Int      @default(0)
  endpoints          Json?
  idempotencyKeyPath String?
  fxActor            Json?
  schemaVersion      Int      @default(1)
  state              String   @default("PROPOSED") // PROPOSED|PROVISIONED|SMOKE_TESTED|ENABLED|QUARANTINED|RETIRED
  blueprintId        String?
  authorCommitment   String
  authorizedBy       String?
  signerCommitment   String? // Phase 21: authorized Ed25519 signer for live settlements
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  version            Int      @default(1)

  @@index([state])
  @@index([category])
  @@index([blueprintId])
}

/// Rail Factory — an authenticated, idempotent settlement on an ENABLED rail (Phase 21).
/// (railKey, reference) is the DB-unique idempotency guard: a redelivered settlement
/// returns the ORIGINAL row and never double-settles.
model RailSettlement {
  id              String   @id @default(cuid())
  settlementId    String   @unique
  railKey         String
  reference       String
  signerCommitment String
  payload         Json
  fxRateUsd       Float?
  creditedAngel   Int      @default(0)
  status          String   @default("PENDING") // PENDING | SETTLED | PENDING_REVIEW | REJECTED
  errorTranche    String   @default("NONE")
  createdAt       DateTime @default(now())
  settledAt       DateTime?

  @@unique([railKey, reference])
  @@index([status])
  @@index([railKey])
  @@index([settlementId])
}

/// Rail Factory — a discovered candidate rail awaiting scoring/spec-proposal (Phase 19).
/// fingerprint is the content-hash of the normalized payload and doubles as the dedupe key.
model RailCandidate {
  id                   String   @id @default(cuid())
  fingerprint          String   @unique
  source               String
  payload              Json
  score                Float    @default(0)
  rationale            String?
  needsReview          Boolean  @default(false)
  proposedBlueprintId  String?
  createdAt            DateTime @default(now())

  @@index([source])
  @@index([score])
}

/// Rail Factory — per-settlement telemetry for an ENABLED rail (Phase 19).
/// Feeds the auto-quarantine feedback loop (3 consecutive SLA breaches -> QUARANTINED).
model RailTelemetry {
  id              String   @id @default(cuid())
  railKey         String
  seq             Int      @default(0)
  latencyMs       Int      @default(0)
  volumeUnits     Int      @default(0)
  dedupeHits      Int      @default(0)
  errorTranche    String   @default("NONE") // "NONE" | "SLA_BREACH" | "DATA_LEAKAGE" | "COMPUTE_TIMEOUT" | "LOGIC_DETECTION"
  settlementCount Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([railKey, seq])
  @@index([errorTranche])
}

/// Rail Factory — a generalized provisioning runbook/blueprint (Phase 19).
/// Captured from manual provisioning sessions; promoted to `automated` once 3+ sample
/// specs share >85% structural similarity, after which matching candidates auto-provision.
model RailRunbook {
  id                      String   @id @default(cuid())
  blueprintId             String   @unique
  sampleSpecs             Json
  generalization          Json?
  successMetrics          Json?
  promotedFromCandidateId String?
  automated               Boolean  @default(false)
  createdAt               DateTime @default(now())

  @@index([automated])
}

/// Continuous cryptographic integrity attestation (Phase 23).
/// An append-only, Ed25519-chained certificate that the money ledgers stayed conserved.
/// attestationHash = sha256(canonicalJson(body without signature)); prev chains the prior
/// attestationHash so the entire health history is tamper-evident and remotely verifiable.
model IntegrityAttestation {
  id                    String   @id @default(cuid())
  attestationId         String   @unique
  checkedAt             DateTime
  ok                    Boolean
  supplyConsistent      Boolean
  fractionalConsistent  Boolean
  lpInvariantOk         Boolean
  pendingReviewStale    Int      @default(0)
  settledTotalCredited  Int      @default(0)
  settledTotalRows      Int      @default(0)
  issues                Json?
  prevAttestationHash   String?
  attestationHash       String   @unique
  signature             String
  publicKey             String? // Phase 25: the Ed25519 public key that signed THIS attestation.
                               // Stored so offline verification works after the signing key rotates
                               // (each attestation verifies against the key that actually signed it).
  algorithm             String   @default("ed25519")
  createdAt             DateTime @default(now())

  @@index([checkedAt])
  @@index([ok])
}

/// Execution safety interlock (Phase 24). Single-row KV: when liveExecutionHalted=true,
/// `canExecuteLive` returns false for EVERY rail regardless of sandboxUrl — a durable, atomic,
/// cryptographically-flagged hard stop that no rail can ride through.
model ExecutionSafetyFlag {
  id                    String   @id @default(cuid())
  liveExecutionHalted   Boolean  @default(false)
  haltedAt              DateTime?
  reason                String?
  causedByAttestationId String?
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt
}

/// Era-based rail signer keys (Phase 24). Replaces the legacy single `signerCommitment` column
/// with a versioned, rotatable key chain. `verifySettlementSignature` resolves the key valid at
/// the time of the settlement, so an actively-rotated key invalidates the old one without
/// breaking historical verification.
model RailSignerKey {
  id         String   @id @default(cuid())
  railKey    String
  publicKey  String
  validFrom  DateTime @default(now())
  validUntil DateTime?
  createdAt  DateTime @default(now())

  @@index([railKey, validFrom])
  @@index([railKey, publicKey])
}

/// Signed, chained breach-response attestation (Phase 24). Idempotent per responseId (which is
/// the causedByAttestationId). Each halt/revival is itself cryptographically verifiable.
model BreachResponse {
  id                    String   @id @default(cuid())
  responseId            String   @unique
  causedByAttestationId String
  halted                Boolean
  quarantinedRails      String[]
  at                    DateTime
  attestationHash       String
  prevAttestationHash   String?
  signature             String
  publicKey             String
  algorithm             String   @default("ed25519")
  createdAt             DateTime @default(now())

  @@index([causedByAttestationId])
  @@index([at])
}




