/// Smelting Run Telemetry (Automated Mine-Gate Pour Log).
/// Ingests automated weight, specific gravity density, and inline XRF purities directly from furnace edge HSM.
model SmeltingRunTelemetry {
  id                   String   @id @default(cuid())
  runNumber            String   @unique // "SMELT-FEK-2026-0001"
  concessionId         String
  concessionCode       String
  grossPouredGrams     Float
  densityGramsPerCc    Float    // Specific gravity: 15.0 - 19.32 g/cm³
  estimatedAuFineness  Float    // Inline XRF gold purity: 0.70 - 0.98
  estimatedAgFineness  Float    @default(0.08) // Silver by-product purity: 0.02 - 0.20
  fineGoldGrams        Float    // grossPouredGrams * estimatedAuFineness
  fineSilverGrams      Float    // grossPouredGrams * estimatedAgFineness
  goldSpotUsdPerGram   Float
  silverSpotUsdPerGram Float    @default(0.95)
  grossMarketValueUsd  Float
  royaltyDueUsd        Float
  royaltyDueAngel      Int      // Math.floor(royaltyDueUsd / 5.0)
  stateShareDueAngel   Int      // State equity dividend in AngelCoin
  hsmSignature         String   // Ed25519 signature over canonical pour payload
  status               String   @default("POURED") // "POURED", "DISPATCHED_TO_REFINERY", "REFINED_SETTLED"
  refinedBatchNumber   String?
  pouredAt             DateTime @default(now())

  concession           IndustrialMiningConcession @relation(fields: [concessionId], references: [id])

  @@index([concessionCode])
  @@index([status])
  @@index([pouredAt])
}

