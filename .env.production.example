# Production/staging environment for passport.metis.gold (Railway)
# Copy values into Railway Variables — never commit real secrets to git.
# Real rollout requires PostgreSQL. Do not use file:/SQLite in staging/prod.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway?schema=public"
SIGNING_PRIVATE_KEY="replace-with-ed25519-private-key-hex"
INGESTION_COMMITMENT_SALT="replace-with-long-random-rollout-salt"
SESSION_SECRET="replace-with-random-64-hex-session-secret"

# Comma-separated executive admin allowlist for the dev/CEO console.
ADMIN_OPERATOR_EMAILS=""

# Evidence bridge / liability flags.
# EVIDENCE_BRIDGE_OPERATOR_ID must reference the seeded PUBLIC_EVIDENCE_MINTER Operator.id.
# Leave EVIDENCE_ENFORCEMENT_ENABLED false until smoke and monitoring are healthy.
EVIDENCE_BRIDGE_OPERATOR_ID=""
EVIDENCE_ENFORCEMENT_ENABLED="false"
# task_deliverable evidence ingestion gate.
EVIDENCE_SERVICE_AUTH_REQUIRED="true"
PASSPORT_SERVICE_TOKEN="replace-with-service-token"

# ---- Audit-fix hardening (Loop 80) ----
# Mobile-money callback HMAC secret(s). REQUIRED when the digital gateway is
# live: without one, callbacks are refused (previously a predictable default
# secret let forged callbacks mint ANGEL). Per-provider override:
# MOBILE_MONEY_SECRET_ORANGEMONEY / _MOOV / _MOMO.
MOBILE_MONEY_SECRET=""
# NOTE: EVIDENCE_SERVICE_AUTH_BYPASS is forced OFF in production and is only
# honoured in non-production test runs. Do not set it in production.
# Referral redemption lifetime cap (default 10).
REFERRAL_MAX_USES="10"
# Threat-report bounty daily cap per reporter (default 3).
SWARM_MAX_REPORTS_PER_DAY="3"

NEXT_PUBLIC_APP_URL="https://passport.metis.gold"

# Stripe is optional unless billing is enabled. If STRIPE_SECRET_KEY is set,
# STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_PRO, and NEXT_PUBLIC_APP_URL are required.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NODE_ENV="production"

# GitHub OAuth (optional — set both for GitHub login)
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (optional — set both for Google login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stablecoin (USDC) + Bridge (Open Issuance) + AngelCoin compliance — only when needed.
BRIDGE_CLIENT_ID=""
BRIDGE_CLIENT_SECRET=""
BRIDGE_ENV="sandbox"            # sandbox | live
BRIDGE_WEBHOOK_SECRET=""
ANGL_WITHDRAW_KYC_ONLY="true"   # enforced in live regardless
ANGL_BLOCKED_ADDRESSES=""       # comma-separated sanctioned addresses
ANGL_BLOCKED_COUNTRIES=""       # comma-separated ISO-2 geofenced codes

# ASMC-3 Sovereign Haven: Trilateral Sovereign State Public Keys (AES 2-of-3 Quorum)
# Ed25519 64-hex public keys of sovereign state ministries. REQUIRED in production:
# these paths fail closed if unset. Do not use the local benchmark keys here.
SOVEREIGN_KEY_ML="replace-with-ml-64-hex-ed25519-public-key"
SOVEREIGN_KEY_BF="replace-with-bf-64-hex-ed25519-public-key"
SOVEREIGN_KEY_NE="replace-with-ne-64-hex-ed25519-public-key"

# Phase 38 signer provenance. Audit fix M10: signature verification is ON by
# default in every non-test environment. Set to "0" ONLY to deliberately
# downgrade a local sandbox (not recommended). For a fully unsigned sandbox use
# ALLOW_UNSIGNED_RESERVES="1" instead.
ENFORCE_SIGNATURES="1"
# Comma-separated 64-hex public keys authorized to verify stabilization milestones.
# REQUIRED: an empty allowlist fails closed in production.
MILESTONE_VERIFIER_KEYS=""

# Command Brain cadence (cron expression; default every 10 min).
# BRAIN_SCHEDULE=""

# ---- Two-persona self-dialogue (MARS aggressive / MUSE creative) ----
# Master switch for the continuous mission-reflection loop (default true).
# BRAIN_DIALOGUE_ENABLED="true"
# Minimum minutes between dialogue runs (default 10 = every cycle; raise to cut cost).
# BRAIN_DIALOGUE_MIN_INTERVAL_MINUTES="10"
# Max concurrently-ACTIVE brain-authored missions (default 5).
# BRAIN_MAX_ACTIVE_MISSIONS="5"
# Per-persona models (must be on the cortex tier allowlist; distinct by default).
# LLM_MODEL_MARS="deepseek/deepseek-v4.1-flash"
# LLM_MODEL_MUSE="z-ai/glm-5.3-flash"
# Default model for the cortex tier (cheap reasoning).
# LLM_MODEL_CORTEX="z-ai/glm-5.3-flash"
# Neuron tier = the brain's primary reasoning model.
# LLM_MODEL_NEURON="deepseek/deepseek-v4.1-flash"

# ---- Moltbook (external AI-agent forum: read/learn + optional posting) ----
# Agent API key from POST /api/v1/agents/register (sent to the owner as a claim link).
# MOLTBOOK_API_KEY=""
# Enable the read/learn heartbeat (default enabled; no-ops without a key).
# MOLTBOOK_ENABLED="true"
# Cron for the Moltbook read pass (default every 30 min).
# MOLTBOOK_CHECK_SCHEDULE="*/30 * * * *"

# Revenue runner — off by default in production. Enable only with a trusted external partner.
# REVENUE_RUNNER_ENABLED="0"

# ---- Scheduler auth ----
# Shared secret for internal scheduler/admin tick endpoints. REQUIRED in
# production (the guard fails closed only in production).
# SCHEDULER_SECRET=""
# Environment identity: only SCHEDULER_ROLE=primary runs the in-process
# schedulers. Set it to "secondary" on every other environment (staging, a
# second replica you do not want scheduling) so only one environment schedules.
# SCHEDULER_ROLE="primary"

# ---- Telegram Commander ----
# Bot token from @BotFather. Keep secret; grants full control of the bot.
# TELEGRAM_BOT_TOKEN=""
# Secret token passed to setWebhook and verified on every update.
# TELEGRAM_WEBHOOK_SECRET=""
# Comma-separated Telegram chat ids allowed to command the brain (fail closed).
# TELEGRAM_COMMANDER_CHAT_IDS=""

# ---- Commander fleet-watch ----
# The Commander probes each earning system and reports to Telegram.
# Callora (call-center) + Medora (job-finder) share one host.
# CALLORA_BASE_URL="https://call.metis.gold"
# Secret to read the Medora pipeline (falls back to CRON_SECRET).
# CALLORA_CRON_SECRET=""
# The separate Marketplace repo (AgentMarket) base URL.
# MARKETPLACE_BASE_URL=""
# Cron for the autonomous digest (default: every 6 hours).
# FLEET_WATCH_SCHEDULE="0 */6 * * *"
# Set false to disable the periodic digest entirely.
# FLEET_WATCH_ENABLED="true"
