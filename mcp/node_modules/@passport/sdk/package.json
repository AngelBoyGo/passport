{
  "name": "@passport/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Passport SDK — cryptographic identity and authenticity layer for AI agents. Issue receipts, post evidence, verify agents.",
  "keywords": ["ai", "agent", "identity", "verification", "receipt", "ed25519", "passport"],
  "homepage": "https://passport.metis.gold",
  "repository": { "type": "git", "url": "https://github.com/AngelBoyGo/passport.git" },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./mastra": {
      "import": {
        "types": "./dist/middleware/mastra.d.ts",
        "default": "./dist/middleware/mastra.mjs"
      },
      "require": {
        "types": "./dist/middleware/mastra.d.ts",
        "default": "./dist/middleware/mastra.js"
      }
    },
    "./vercel-ai": {
      "import": {
        "types": "./dist/vercel-ai.d.ts",
        "default": "./dist/vercel-ai.mjs"
      },
      "require": {
        "types": "./dist/vercel-ai.d.ts",
        "default": "./dist/vercel-ai.js"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.mjs"
      },
      "require": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
